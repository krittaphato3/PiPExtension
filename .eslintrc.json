{
  "env": {
    "browser": true,
    "es2021": true,
    "webextensions": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-undef": "error",
    "no-redeclare": "off",
    "eqeqeq": ["warn", "smart"],
    "no-constant-condition": "warn",
    "no-empty": ["warn", { "allowEmptyCatch": true }]
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "env": {
        "node": true,
        "browser": false,
        "webextensions": false
      },
      "rules": {
        "no-undef": "off",
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["background.js"],
      "globals": {
        "importScripts": "readonly",
        "PiPFactory": "readonly",
        "NativePipStateManager": "readonly"
      }
    },
    {
      "files": ["content.js"],
      "globals": {
        "PiPFactory": "readonly"
      }
    },
    {
      "files": ["lib/pipFactory.js"],
      "globals": {
        "module": "readonly"
      }
    }
  ]
}
